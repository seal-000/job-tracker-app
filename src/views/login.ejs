<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Sign in</title>
    <link rel="icon" href="/favicon.ico">
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>
    <main class="auth-page register-page">
        <section class="register-story" aria-label="JobTracker introduction">
            <a class="register-brand" href="/login" aria-label="JobTracker home">
                <i data-lucide="briefcase-business"></i>
                <span>JOB TRACKER</span>
            </a>

            <div class="register-story-copy">
                <p class="register-eyebrow" data-depth="0.3">YOUR JOB SEARCH, IN FOCUS</p>
                <h1 data-depth="1">Your next step<br>starts here.</h1>
                <p class="register-description" data-depth="0.65">Sign in to review your applications and keep your job search moving.</p>
                <div class="register-tagline" data-depth="0.45">
                    <span aria-hidden="true"></span>
                    <p>Every application. One clear view.</p>
                </div>
            </div>
            <span class="register-dots register-dots-top" aria-hidden="true"></span>
            <span class="register-dots register-dots-bottom" aria-hidden="true"></span>
            <span class="register-ribbon register-ribbon-one" aria-hidden="true"></span>
            <span class="register-ribbon register-ribbon-two" aria-hidden="true"></span>
        </section>

        <section class="register-form-panel" aria-labelledby="login-title">
            <div class="register-form-wrap">
                <header class="register-form-heading">
                    <h2 id="login-title">Welcome back</h2>
                    <p>Sign in to continue your job search.</p>
                </header>

            <% if (typeof error !== 'undefined' && error) { %>
                <div class="auth-error"><%= error %></div>
            <% } %>

                <form action="/login" method="POST" class="register-form">

                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                    <div class="form-group">
                        <label for="email">Email</label>
                        <input
                            type="email"
                            id="email"
                            name="email"
                            placeholder="your@email.com"
                            autocomplete="email"
                            required
                        >
                    </div>

                    <div class="form-group">
                        <label for="password">Password</label>
                        <input
                            type="password"
                            id="password"
                            name="password"
                            autocomplete="current-password"
                            required
                        >
                        <label class="password-checkbox">
                            <input type="checkbox" data-password-toggle="password">
                            Show password
                        </label>
                    </div>

                    <button type="submit" class="btn-primary register-submit">
                        <span>Sign in</span>
                        
                    </button>

                </form>

                <p class="auth-footer register-footer register-footer-no-divider">
                    <a href="/forgot-password">Forgot your password?</a>
                </p>

                <p class="auth-footer register-footer">
                    <span>New to Job Tracker?</span>
                    <a href="/register">Create account</a>
                </p>
            </div>
        </section>
    </main>

    <script src="/js/password-toggle.js"></script>
    <script src="/js/register-story.js"></script>
    <script src="https://unpkg.com/lucide@latest"></script>
    <script>
        lucide.createIcons();
    </script>

</body>
</html>