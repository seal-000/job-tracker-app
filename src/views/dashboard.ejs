<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Job Tracker</title>
    <link rel="stylesheet" href="/css/style.css">
</head>

<body>

    <%- include('partials/navbar') %>

    <div id="jt-root">
        <div class="jt-header">
            <p class="jt-title">Job Search Pipeline</p>
            <p class="jt-sub">Track every application from submission to outcome.</p>
        </div>

        <div id="jt-stats" class="jt-stats"></div>

        <div class="jt-addbar">
            <input id="jt-company" type="text" placeholder="Company">
            <input id="jt-role" type="text" placeholder="Role">
            <button class="jt-addbtn" id="jt-add">Add application</button>
        </div>

        <div id="jt-board" class="jt-board">
            <div class="jt-loading">Loading your pipeline…</div>
        </div>
    </div>

    <script>
        window.CSRF_TOKEN = "<%= csrfToken %>";
    </script>
    <script src="/js/dashboard.js"></script>

</body>
</html>
