<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Choose New Password</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <div class="auth-page">
        <div class="auth-card">
            <h1>Choose a new password</h1>

            <% if (error) { %>
                <div class="auth-error"><%= error %></div>
            <% } %>

            <% if (token) { %>
                <form action="/reset-password" method="POST">
                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                    <input type="hidden" name="token" value="<%= token %>">
                    <div class="form-group">
                        <label for="password">New password</label>
                        <input type="password" id="password" name="password" required minlength="8"
                            pattern="(?=.*[A-Z])(?=.*[a-z])(?=.*\d).{8,}"
                            title="Password must be at least 8 characters, include one uppercase letter, one lowercase letter, and one number">
                        <label class="password-checkbox">
                            <input type="checkbox" data-password-toggle="password">
                            Show password
                        </label>
                    </div>
                    <button type="submit" class="btn-primary">Update password</button>
                </form>
            <% } %>

            <p class="auth-footer"><a href="/login">Back to login</a></p>
        </div>
    </div>
    <script src="/js/password-toggle.js"></script>
</body>
</html>